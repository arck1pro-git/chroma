{
  "manifest_version": 3,
  "name": "AmaanOffice · Reuniões",
  "version": "0.1.0",
  "description": "Grava a reunião do Meet ou do Zoom (web), transcreve e sugere como conduzir quando o lead levanta uma objeção.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabCapture",
    "offscreen",
    "sidePanel",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://amaanoffice.amaan.com.br/*",
    "https://chromacrm.vercel.app/*",
    "http://localhost:3000/*",
    "https://meet.google.com/*",
    "https://zoom.us/*",
    "https://*.zoom.us/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Gravar a reunião e abrir o copiloto"
  },
  "side_panel": {
    "default_path": "painel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Gravar a reunião e abrir o copiloto"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://zoom.us/wc/*",
        "https://*.zoom.us/wc/*"
      ],
      "js": [
        "aviso-reuniao.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
