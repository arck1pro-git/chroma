# Copie para .env e preencha. Nada aqui pode ter valor real — este arquivo vai
# para o git; o .env não.
#
# Regra: só variável com NEXT_PUBLIC_ chega ao navegador. Todo o resto fica no
# servidor. Não prefixe segredo com NEXT_PUBLIC_.

# ── Banco ───────────────────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → "Transaction"
# (porta 6543, o pooler certo para serverless). Senha URL-encodada: $ vira %24,
# @ vira %40, senão o parser quebra no @.
DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres

# Mesma base, role SEM privilégio de escrita (`chroma_ia`, criado em
# migration-revisao-modulos.sql §5). É por aqui que a IA lê o CRM: com ela, "a
# IA não pode apagar nada" deixa de ser uma frase no prompt e passa a ser um
# erro do Postgres. Se ficar vazia, lib/ia/db.ts cai na DATABASE_URL acima
# (a IA lê como dono) e avisa no log — funciona, mas sem a trava.
DATABASE_URL_IA=postgresql://chroma_ia:<senha>@<mesmo host>/<mesma base>

# ── Mídia de atendimento (lib/midia.ts) ─────────────────────────────────────
# Onde os anexos recebidos no WhatsApp (imagem, áudio, documento) são gravados.
# Fora de /public de propósito: conversa de cliente não pode ser servida por URL
# adivinhável — quem entrega é /api/midia/<id da mensagem>.
# ⚠ Disco local não sobrevive a deploy em serverless. Trocar por bucket é mudar
# salvarArquivo/lerArquivo em lib/midia.ts, sem mexer no schema.
MIDIA_DIR=.midias
# Teto por arquivo, em MB. Padrão 32.
MIDIA_TETO_MB=32

# ── Supabase Realtime (navegador) ───────────────────────────────────────────
# Project Settings → API. A anon key é pública por design — é ela que o
# Realtime usa no browser.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# ── uazapi (WhatsApp não-oficial) ───────────────────────────────────────────
# A instância (base_url + token) NÃO fica aqui: é cadastrada em Configurações e
# vive em instancias_uazapi. Sem nenhuma cadastrada, o CRM recusa o envio em vez
# de tentar por um número que ele não conhece (lib/uazapi.ts).
#
# Abaixo fica só o segredo do WEBHOOK, que é do endpoint e não da instância: ele
# vai na querystring da URL cadastrada e é conferido em app/api/uazapi/webhook.
# ATENÇÃO: a instância arckwpp é compartilhada com o SprintHub; o webhook de lá
# não deve ser repontado.
UAZAPI_WEBHOOK_SECRET=<segredo que você define e confere no webhook>

# ── Automações: CRM → n8n ───────────────────────────────────────────────────
# Endereço da sua instância do n8n. A API pública responde em {BASE}/api/v1.
N8N_BASE_URL=https://n8n.suaempresa.com.br
# n8n → Settings → n8n API → Create an API key. Vai no header X-N8N-API-KEY.
N8N_API_KEY=<api key do n8n>

# ── Automações: n8n → CRM ───────────────────────────────────────────────────
# Endereço PÚBLICO do CRM, do ponto de vista do n8n. Em produção é o domínio;
# em desenvolvimento depende de onde o n8n roda (ver docs/automacoes-n8n.md).
# Token que o n8n manda de volta ao chamar /api/automacoes/*. Você inventa:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# O mesmo valor entra numa credencial Header Auth dentro do n8n.
# SEM ELE as rotas /api/automacoes/* respondem 401 a tudo — a porta fica
# fechada, não aberta.
CRM_SERVICE_TOKEN=<gere com o comando acima>

# ── Automações: freio de mão do disparo ─────────────────────────────────────
# A instância uazapi é COMPARTILHADA com o SprintHub: uma automação em looping
# aqui vira número banido lá.
#
# O modo simulação (AUTOMACOES_DISPARAR) foi REMOVIDO em 2026-09-09: publicar
# uma cadência agora liga e inscreve, e as mensagens saem. O teto abaixo é a
# única contenção que restou — e ele limita a velocidade do estrago, não o
# estrago.
# Teto de mensagens de automação por minuto, no CRM inteiro. Padrão 12.
AUTOMACOES_MSGS_POR_MINUTO=12

# ── IA: conversar sobre a tela ──────────────────────────────────────────────
# console.anthropic.com → API keys. A chave NUNCA vai pro navegador: quem fala
# com o modelo é app/api/ia/route.ts, no servidor.
ANTHROPIC_API_KEY=<sk-ant-...>
# Deixe em 'false' (ou omita) e a IA não recebe whatsapp/e-mail dos contatos —
# só nome e cidade. Ligue conscientemente se precisar que ela leia isso.
IA_ENVIAR_CONTATO_PII=false
# Modelo. Padrão claude-sonnet-5 (barato e rápido, suficiente pra ler números).
# Troque por claude-opus-5 quando as perguntas ficarem mais difíceis.
IA_MODELO=claude-sonnet-5
