  "mensagens": [
    { "id": "demo-m-0101", "atendimento_id": "demo-a-01", "origem": "agente", "autor_id": null, "enviada_por": "automacao", "texto": "*Turmalina Tower — nova tabela*\n\nOlá, Carlos! Abrimos a tabela de setembro do Turmalina Tower, em Porto Belo, com condição especial para os studios de 28 m². Quer receber a planta e a simulação de rentabilidade?\n\n_Amaan Incorporadora_", "status": "lido", "tipo": "texto", "data_criacao": "2026-09-27T13:00:00Z" },
    { "id": "demo-m-0102", "atendimento_id": "demo-a-01", "origem": "contato", "autor_id": null, "enviada_por": null, "texto": "Oi! Quero sim, tenho interesse no studio.", "status": "recebido", "tipo": "texto", "data_criacao": "2026-09-28T14:38:00Z" },
    { "id": "demo-m-0103", "atendimento_id": "demo-a-01", "origem": "contato", "autor_id": null, "enviada_por": null, "texto": "Ele já vem mobiliado? E como funciona o pool de locação?", "status": "recebido", "tipo": "texto", "data_criacao": "2026-09-28T14:39:00Z" },

    { "id": "demo-m-0201", "atendimento_id": "demo-a-02", "origem": "agente", "autor_id": null, "enviada_por": "automacao", "texto": "*Convite — Open House*\n\nOlá, Beatriz! Neste sábado teremos Open House no decorado do Turmalina Tower, das 10h às 16h. Posso reservar um horário para você?\n\n_Amaan Incorporadora_", "status": "entregue", "tipo": "texto", "data_criacao": "2026-09-25T13:00:00Z" },

    { "id": "demo-m-0301", "atendimento_id": "demo-a-03", "origem": "contato", "autor_id": null, "enviada_por": null, "texto": "Bom dia! Vi o anúncio do Turmalina. Vocês aceitam permuta com terreno?", "status": "recebido", "tipo": "texto", "data_criacao": "2026-09-27T09:02:00Z" },
    { "id": "demo-m-0302", "atendimento_id": "demo-a-03", "origem": "agente", "autor_id": "EU", "enviada_por": "crm", "texto": "Bom dia, Rafael! Avaliamos permuta sim, dependendo da localização. O terreno é em qual cidade?", "status": "lido", "tipo": "texto", "data_criacao": "2026-09-27T09:10:00Z" },
    { "id": "demo-m-0303", "atendimento_id": "demo-a-03", "origem": "contato", "autor_id": null, "enviada_por": null, "texto": "Fica em Itapema, 450 m². Te mando a matrícula depois.", "status": "recebido", "tipo": "texto", "data_criacao": "2026-09-27T09:15:00Z" },

    { "id": "demo-m-0401", "atendimento_id": "demo-a-04", "origem": "contato", "autor_id": null, "enviada_por": null, "texto": "Oi Patricia, tudo bem? Consegui falar com meu marido sobre o apartamento de 2 dormitórios.", "status": "recebido", "tipo": "texto", "data_criacao": "2026-09-27T18:12:00Z" },
    { "id": "demo-m-0402", "atendimento_id": "demo-a-04", "origem": "agente", "autor_id": "EU", "enviada_por": "crm", "texto": "Oi Juliana! Que ótimo 😊 E o que vocês acharam?", "status": "lido", "tipo": "texto", "data_criacao": "2026-09-27T18:20:00Z" },
    { "id": "demo-m-0403", "atendimento_id": "demo-a-04", "origem": "contato", "autor_id": null, "enviada_por": null, "texto": "Gostamos muito da unidade 1204, a de frente pro mar. Dá pra parcelar a entrada em 12x?", "status": "recebido", "tipo": "texto", "data_criacao": "2026-09-28T13:55:00Z" },
    { "id": "demo-m-0404", "atendimento_id": "demo-a-04", "origem": "agente", "autor_id": "EU", "enviada_por": "aparelho", "texto": "Dá sim! A entrada pode ser em até 12x sem juros durante a obra.", "status": "lido", "tipo": "texto", "data_criacao": "2026-09-28T14:05:00Z" },
    { "id": "demo-m-0405", "atendimento_id": "demo-a-04", "origem": "agente", "autor_id": "EU", "enviada_por": "crm", "texto": "Vou montar a simulação com a 1204 e te mando ainda hoje.", "status": "entregue", "tipo": "texto", "data_criacao": "2026-09-28T14:06:00Z" },
    { "id": "demo-m-0406", "atendimento_id": "demo-a-04", "origem": "contato", "autor_id": null, "enviada_por": null, "texto": "Perfeito, obrigada!", "status": "recebido", "tipo": "texto", "data_criacao": "2026-09-28T14:31:00Z" },

    { "id": "demo-m-0501", "atendimento_id": "demo-a-05", "origem": "contato", "autor_id": null, "enviada_por": null, "texto": "Boa tarde, vocês têm unidade com 3 suítes?", "status": "recebido", "tipo": "texto", "data_criacao": "2026-09-28T14:20:00Z" },
    { "id": "demo-m-0502", "atendimento_id": "demo-a-05", "origem": "contato", "autor_id": null, "enviada_por": null, "texto": "Pode ser a partir de 120 m².", "status": "recebido", "tipo": "texto", "data_criacao": "2026-09-28T14:21:00Z" },

    { "id": "demo-m-0601", "atendimento_id": "demo-a-06", "origem": "contato", "autor_id": null, "enviada_por": null, "texto": "Assinei o contrato, obrigada por tudo!", "status": "recebido", "tipo": "texto", "data_criacao": "2026-09-24T16:50:00Z" },
